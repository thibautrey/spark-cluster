{
  "schema_version": "spark-cluster.recipe/v1",
  "id": "thibautrey/qwen38-flash-next-spark",
  "version": "1.0.0",
  "controller_min_version": "0.1.0",
  "title": "Qwen3.8 Flash-Next \u00b7 NVFP4 \u00b7 1 Spark",
  "description": "Qwen3.8 Flash-Next \u00b7 NVFP4 \u00b7 1 Spark starter for one 128 GB DGX Spark. Exact weights and ARM64 runtime are pinned; hardware verification remains required.",
  "license": "Apache-2.0",
  "source": {
    "repository": "NVIDIA/local-ai-inference-recipes",
    "commit": "7b2ee453234617f58e1e100c195ac3be7f79e233",
    "path": "models/qwen/qwen3.8-flash-next/dgx-spark/linux/vllm/fp4-local/recipe.yaml",
    "license": "LicenseRef-NvidiaProprietary; header also references Apache-2.0"
  },
  "model": {
    "repository": "nvidia/Qwen3.8-Flash-Next-FP4-Local",
    "license": "NVIDIA checkpoint license (see pinned model card)",
    "revision": "b9ce18a6887e18c089fdea8509a33e63429a3300"
  },
  "requirements": {
    "hardware": "dgx-spark",
    "platform": "linux/arm64",
    "nodes": 1,
    "memory_gib_per_node": 115,
    "disk_gib_per_node": 250,
    "topology": "single"
  },
  "runtime": {
    "image": "docker.io/eugr/spark-vllm-b12x@sha256:03a956544e9f9b4b7ba91690469fbe7848bdbef29a7d2e0f5788368467bb3595",
    "arguments": [
      "--mamba-cache-mode",
      "align",
      "--enable-prefix-caching",
      "--enable-chunked-prefill",
      "--dtype",
      "bfloat16",
      "--kv-cache-dtype",
      "fp8",
      "--quantization",
      "modelopt_mixed",
      "--block-size",
      "16",
      "--load-format",
      "b12x",
      "--speculative-config",
      "{\"method\":\"mtp\",\"num_speculative_tokens\":4}",
      "--gdn-decode-kernel",
      "b12x",
      "--linear-backend",
      "b12x",
      "--moe-backend",
      "b12x",
      "--no-enable-flashinfer-autotune",
      "--mm-encoder-tp-mode",
      "data",
      "--reasoning-parser",
      "qwen3",
      "--tool-call-parser",
      "qwen3_xml",
      "--enable-auto-tool-choice",
      "--compilation-config",
      "{\"pass_config\":{\"fuse_act_quant\":true}}"
    ],
    "environment": {
      "VLLM_PLE_TABLE_MEMORY": "disk",
      "B12X_DISK_BACKEND": "io_uring",
      "CUTE_DSL_ARCH": "sm_121a",
      "SAFETENSORS_FAST_GPU": "1",
      "VLLM_WORKER_MULTIPROC_METHOD": "spawn",
      "VLLM_SSM_CONV_STATE_LAYOUT": "DS",
      "VLLM_USE_AOT_COMPILE": "1",
      "VLLM_USE_MEGA_AOT_ARTIFACT": "1",
      "VLLM_USE_V2_MODEL_RUNNER": "1",
      "B12X_POLICY_MODE": "auto",
      "VLLM_MXFP8_LM_HEAD": "1",
      "VLLM_B12X_MOE_FP4_LAYER_MAX_INPUT_SCALE": "w13",
      "VLLM_B12X_MOE_FP4_FORCE_A16": "1",
      "B12X_W4A16_A4_PREFILL": "1"
    },
    "unconfined": true
  },
  "launch": {
    "model_id": "nvidia/Qwen3.8-Flash-Next-FP4-Local",
    "served_model_name": "qwen38-flash-next-spark",
    "engine_id": "vllm",
    "bits_per_weight": 4,
    "context_length": 32768,
    "max_num_seqs": 1,
    "max_num_batched_tokens": 4096,
    "tensor_parallel": 1,
    "pipeline_parallel": 1,
    "gpu_memory_utilization": 0.8,
    "memory_budget_mode": "fixed",
    "kv_cache_dtype": "fp8_e4m3",
    "cache_cpu_gib": 0,
    "cache_disk_gib": 0,
    "speculative_method": "off"
  },
  "validation": "source-reviewed",
  "notes": [
    "Adapted from NVIDIA configuration facts; upstream copyright belongs to NVIDIA CORPORATION & AFFILIATES. Consult the pinned source for its license terms.",
    "Source uses nightly-20261015; this recipe pins its ARM64 manifest digest resolved on 2026-11-02.",
    "Context and concurrency reduced to 32768 / 1 for initial admission; source measurements do not validate this exact revision and configuration.",
    "B12x disk-backed PLE and compilation use an isolated persistent Docker cache volume.",
    "Requires CUDA 13 / compatible Blackwell driver. Source evaluation requests unconfined seccomp/AppArmor; this recipe does too.",
    "Review and accept the checkpoint license before downloading. No local hardware benchmark has been performed."
  ]
}
