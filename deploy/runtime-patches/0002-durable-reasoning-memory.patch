+test "durable reasoning memory restores tool and content histories without changing rendered input" {
+    const a = std.testing.allocator;
+    var arena = std.heap.ArenaAllocator.init(a);
+    defer arena.deinit();
+    const aa = arena.allocator();
+    var m: Memory = .{ .gpa = a, .entries = 4 };
+    defer m.deinit();
+    const calls = (try json.parseText(aa, "[{\"id\":\"call_123\"}]")).ok;
+    m.put("tool reasoning fixture", "", calls.array);
+    m.put("final reasoning fixture", "answer", &.{});
+    const bytes = try m.encode();
+    defer a.free(bytes);
+    var restored: Memory = .{ .gpa = a, .entries = 4 };
+    defer restored.deinit();
+    try restored.decode(bytes);
+    const messages = (try json.parseText(aa, "[{\"role\":\"assistant\",\"tool_calls\":[{\"id\":\"call_123\"}]},{\"role\":\"assistant\",\"content\":\"answer\"}]")).ok;
+    const got = try restored.restore(aa, messages);
+    try std.testing.expectEqualStrings("tool reasoning fixture", got.array[0].strField("reasoning_content").?);
+    try std.testing.expectEqualStrings("final reasoning fixture", got.array[1].strField("reasoning_content").?);
+    bytes[bytes.len - 1] ^= 1;
+    var corrupt: Memory = .{ .gpa = a, .entries = 4 };
+    defer corrupt.deinit();
+    try std.testing.expectError(error.InvalidMemory, corrupt.decode(bytes));
+    try std.testing.expectEqual(@as(usize, 0), corrupt.map.count());
+}
+
+test "reasoning memory survives closing and reopening private atomic storage" {
+    const a = std.testing.allocator;
+    const io = std.testing.io;
+    var tmp = std.testing.tmpDir(.{});
+    defer tmp.cleanup();
+    const path = try tmp.dir.realPathFileAlloc(io, ".", a);
+    defer a.free(path);
+    {
+        var m: Memory = .{ .gpa = a, .entries = 2 };
+        defer m.deinit();
+        try m.open(io, path);
+        m.put("one", "first", &.{});
+        m.put("two", "second", &.{});
+        m.put("three", "third", &.{});
+    }
+    var m: Memory = .{ .gpa = a, .entries = 2 };
+    defer m.deinit();
+    try m.open(io, path);
+    try std.testing.expectEqual(@as(usize, 2), m.map.count());
+    var key: [66]u8 = undefined;
+    try std.testing.expect(m.map.get(Memory.contentKey(&key, "first")) == null);
+    try std.testing.expectEqualStrings("three", m.map.get(Memory.contentKey(&key, "third")).?);
+}
