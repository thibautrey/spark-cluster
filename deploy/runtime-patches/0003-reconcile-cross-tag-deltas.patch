+
+test "restart rebuilds legacy deltas across semantic tags under their original identity" {
+    const a = testing.allocator;
+    var tmp = testing.tmpDir(.{});
+    defer tmp.cleanup();
+    const root = try tmp.dir.realPathFileAlloc(testing.io, ".", a);
+    defer a.free(root);
+    const ids = try chatIds(a, 91, page * 5 + 3);
+    defer a.free(ids);
+    {
+        var r: Rank = undefined;
+        try r.init(a, root, 1, 0, .{ .delta = true });
+        defer r.deinit();
+        const slot = try r.pool.newSlot(16 * page);
+        try slot.ensure(page * 2);
+        r.write(slot, 91, 0);
+        const base_id = (try r.store.save(slot, try HostBounded.make(a, 91, page * 2), ids[0 .. page * 2], 1, 0)).?;
+        try r.store.checkpoint(base_id);
+        const base_key = r.store.entry(base_id).key;
+        try slot.ensure(ids.len);
+        r.write(slot, 91, 2);
+        slot.origin = .{ .key = base_key, .pages = 2 };
+        const next_id = (try r.store.save(slot, try HostBounded.make(a, 91, ids.len), ids, 2, 0)).?;
+        // Simulate the previous writer, which allowed inherited origins across tags.
+        r.disk.get(base_key).?.tag = 2;
+        const job = (try r.store.beginPark(next_id)).?;
+        try testing.expect(job.src.base != null);
+        _ = try r.store.settle(job);
+        _ = try slot.releaseAll();
+    }
+    var r: Rank = undefined;
+    try r.init(a, root, 1, 0, .{});
+    defer r.deinit();
+    try testing.expectEqual(@as(u32, 2), try r.store.reconcile());
+    const query = try a.alloc(i32, ids.len + 1);
+    defer a.free(query);
+    @memcpy(query[0..ids.len], ids);
+    query[ids.len] = 999;
+    const hit = (try r.store.find(2, query)).?;
+    try testing.expectEqual(@as(u64, ids.len), hit.pos);
+    const slot = try r.pool.newSlot(16 * page);
+    const job = try r.store.beginRestore(hit.id, slot);
+    var got = (try r.store.settle(job)).?;
+    defer got.deinit(a);
+    try r.check(slot, 91, ids.len);
+    _ = try slot.releaseAll();
+}
