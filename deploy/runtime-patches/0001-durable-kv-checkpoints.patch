+    /// Persist a snapshot while retaining its RAM copy. Only immutable saved pages are read.
+    /// Pick a persisted strict ancestor for delta writes; branches never reuse unrelated rows.
+    pub fn checkpoint(s: *Store, id: u32) !void {
+        const d = s.disk orelse return;
+        const e = s.index.get(id);
+        if (!e.ram or e.extra.job != null or !d.accepts(e.pos)) return;
+        if (e.extra.file and d.get(e.key) != null) return;
+        if (s.policy.delta) {
+            const ids = try s.gpa.alloc(i32, e.pos);
+            defer s.gpa.free(ids);
+            try s.index.idsOf(id, ids);
+            var end: usize = ids.len;
+            while (end > 0) {
+                const hit = (try s.find(e.tag, ids[0..end])) orelse break;
+                const older = s.index.get(hit.id);
+                if (older.extra.file and d.get(older.key) != null) {
+                    const pages: u32 = @intCast(older.pos / s.pool.page);
+                    if (pages > 0) e.extra.origin = .{ .key = older.key, .pages = pages };
+                    break;
+                }
+                end = @intCast(hit.pos);
+            }
+        }
+        const job = (try s.beginPark(id)) orelse return;
+        job.retain_ram = true;
+        _ = try s.settle(job);
+    }
